{
    "name":  "dsh-external-tools",
    "version":  "1.0.0-beta.15",
    "private":  true,
    "type":  "module",
    "description":  "Standalone Windows rescue and debug console for DSH: one portable EXE that diagnoses DSH, enters safe mode, restores backups, reads logs, kills hung processes, and repairs dependencies. Does not require DSH, Node, or a DSH plugin to run.",
    "license":  "MIT",
    "author":  "Akivelli",
    "exports":  {
                    ".":  "./index.js",
                    "./locale/*.json":  "./locale/*.json",
                    "./icon":  "./icon.svg",
                    "./cordis.patch.yml":  "./cordis.patch.yml",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "index.js",
                  "lib",
                  "bin",
                  "src-exe",
                  "dsh-external-tools.exe",
                  "locale/*.json",
                  "icon.svg",
                  "cordis.patch.yml",
                  "README.md",
                  "CHANGELOG.md",
                  "docs",
                  "LICENSE"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           }
            },
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/745403lkh/dsh-external-tools.git"
                   },
    "homepage":  "https://github.com/745403lkh/dsh-external-tools#readme",
    "bugs":  {
                 "url":  "https://github.com/745403lkh/dsh-external-tools/issues"
             },
    "keywords":  [
                     "deepseek",
                     "deepseek-harness",
                     "dsh",
                     "windows",
                     "portable",
                     "rescue",
                     "diagnostics"
                 ]
}
